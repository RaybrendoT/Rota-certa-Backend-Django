# Copie para deploy/.env no servidor e preencha. Nunca versione o .env.

# Domínio apontado (registro A) para o IP elástico da EC2.
DOMAIN=rotacerta.exemplo.com.br

# --- Banco (Postgres no próprio compose; a DATABASE_URL é montada pelo compose) ---
POSTGRES_DB=route_monitoring
POSTGRES_USER=rotacerta
POSTGRES_PASSWORD=troque-esta-senha

# --- Django ---
DEBUG=False
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ALLOWED_HOSTS=rotacerta.exemplo.com.br
CSRF_TRUSTED_ORIGINS=https://rotacerta.exemplo.com.br
FRONTEND_URL=https://rotacerta.exemplo.com.br/
# HSTS: comece com 0 e só aumente quando o HTTPS estiver estável (ex.: 31536000).
SECURE_HSTS_SECONDS=0

# Superusuário criado na primeira migração (core/migrations/0007). Depois pode apagar daqui.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@rotacerta.exemplo.com.br
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha-tambem

GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_API_URL=https://routes.googleapis.com/directions/v2:computeRoutes

# Assistente de planejamento (Claude). Vazio = assistente desligado.
ANTHROPIC_API_KEY=
PLANNING_MODEL=claude-opus-5-5

# Notificações push (Firebase). Copie o JSON da conta de serviço para deploy/secrets/firebase.json.
FCM_SERVICE_ACCOUNT_FILE=
# FCM_SERVICE_ACCOUNT_FILE=/app/secrets/firebase.json

# --- Imagem do backend (CI/CD). O deploy.sh escolhe a tag; normalmente não mexa. ---
# BACKEND_IMAGE=ghcr.io/raybrendot/rota-certa-backend-django
