# .env.example
DEBUG=True
SECRET_KEY=seu-valor-aqui
ALLOWED_HOSTS=localhost,127.0.0.1
# Obrigatória. Só PostgreSQL é suportado (sem fallback para SQLite).
DATABASE_URL=postgres://postgres:123456@localhost:5432/route_monitoring?sslmode=disable
GOOGLE_MAPS_API_KEY=sua-chave-da-google-routes-api
GOOGLE_ROUTES_API_URL=https://routes.googleapis.com/directions/v2:computeRoutes
# Assistente de planejamento de rotas (Claude, console.anthropic.com). Vazio = assistente desligado.
ANTHROPIC_API_KEY=
# claude-haiku-5-5 (mais barato), claude-sonnet-5-5 ou claude-opus-5-5 (padrão).
PLANNING_MODEL=claude-opus-5-5
# Channel layer do WebSocket (obrigatório com mais de um processo). Vazio = memória.
# Ex.: redis://localhost:6379/0
REDIS_URL=
